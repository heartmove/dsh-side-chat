{
  "name": "dsh-side-chat-plus",
  "version": "0.4.1",
  "description": "侧边聊天 Plus (Side chat Plus) — DSH web plugin: select text in a conversation and ask it in a per-session side chat (hidden ordinary session, own right-side panel, inherits model/effort/permissions, lookup toggle).",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heartmove/dsh-side-chat.git"
  },
  "homepage": "https://github.com/heartmove/dsh-side-chat#readme",
  "bugs": {
    "url": "https://github.com/heartmove/dsh-side-chat/issues"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "plugin",
    "side-chat",
    "sidechat"
  ],
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.21.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client-registry.js",
    "lib/**/*.map",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "src",
    "CHANGELOG.md",
    "docs/official-sidebar-assessment.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && tsdown && node scripts/check-seed-exports.mjs",
    "check:seed": "node scripts/check-seed-exports.mjs",
    "typecheck": "tsc --noEmit",
    "bundle": "tsdown",
    "watch": "tsdown --watch",
    "prepare": "tsdown",
    "test": "vitest run --passWithNoTests"
  },
  "license": "MIT",
  "dependencies": {
    "schemastery": "npm:@deepseek-ai/schemastery@3.18.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "^0.1.7-0",
    "@deepseek-ai/dsh-attachment": "^0.1.7-0",
    "@deepseek-ai/dsh-client-locale": "^0.1.7-0",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.7-0",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.7-0",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.7-0",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.7-0",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.7-0",
    "@deepseek-ai/dsh-host-webserver": "^0.1.7-0",
    "@deepseek-ai/dsh-llm": "^0.1.7-0",
    "@deepseek-ai/dsh-session": "^0.1.7-0",
    "@deepseek-ai/dsh-session-query": "^0.1.7-0",
    "@deepseek-ai/dsh-workspace": "^0.1.7-0",
    "@deepseek-ai/dsh-permission-presets": "^0.1.7-0",
    "@deepseek-ai/dsh-sandbox-policy": "^0.1.7-0",
    "@deepseek-ai/dsh-settings": "^0.1.7-0",
    "@deepseek-ai/dsh-home-paths": "^0.1.7-0",
    "cordis": "^4.0.0-rc.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@deepseek-ai/dsh-agent-preset-registry": "^0.1.7-0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-attachment": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-locale": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-session-query": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-workspace": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-permission-presets": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-settings": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-home-paths": "0.1.7-alpha.1",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "cordis": "npm:@deepseek-ai/cordis@4.0.3",
    "lightningcss": "^1.32.0",
    "react": "^18.2.0",
    "react-dom": "18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8",
    "@deepseek-ai/dsh-agent-preset-registry": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-session-format-catalog": "0.1.7-alpha.1"
  }
}
